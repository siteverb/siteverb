{
  "name": "@siteverb/profiles",
  "version": "0.1.1",
  "description": "Evidence-labeled client compatibility profiles for WebMCP contracts.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "evidence",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evidence/chrome-151-native.json": "./evidence/chrome-151-native.json",
    "./evidence/chrome-152-native.json": "./evidence/chrome-152-native.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "package:check": "publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "webmcp",
    "compatibility",
    "browser-agents"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siteverb/siteverb.git",
    "directory": "packages/profiles"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@siteverb/contracts": "^0.1.1"
  }
}
